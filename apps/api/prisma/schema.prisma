generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  TITLE_CHANGED
  LABELS_CHANGED
}

model User {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  passwordHash   String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  reportedIssues Issue[]      @relation("IssueReporter")
  assignedIssues Issue[]      @relation("IssueAssignee")
  comments       Comment[]
  events         IssueEvent[]
}

model Issue {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(120)
  description String        @db.VarChar(5000)
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  labels      String[]      @default([])
  reporterId  Int
  assigneeId  Int?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  reporter    User          @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  events      IssueEvent[]

  @@index([status, updatedAt])
  @@index([priority, updatedAt])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  issueId   Int
  authorId  Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
}

model IssueEvent {
  id        Int            @id @default(autoincrement())
  issueId   Int
  actorId   Int
  type      IssueEventType
  fromValue String?
  toValue   String?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  issue     Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
}
